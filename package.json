{
  "name": "quran-for-claude-code",
  "displayName": "Quran for Claude Code (Unofficial)",
  "description": "Unofficial community extension. Not affiliated with or endorsed by Anthropic. Read the Quran while Claude Code works — totally offline.",
  "icon": "media/icon.png",
  "version": "0.1.0",
  "publisher": "WisangJatiAnggoro",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/WisangAnggoro/quran-for-claude-code.git"
  },
  "bugs": {
    "url": "https://github.com/WisangAnggoro/quran-for-claude-code/issues"
  },
  "homepage": "https://github.com/WisangAnggoro/quran-for-claude-code#readme",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "quranForClaudeCode",
          "title": "Quran",
          "icon": "media/book.svg"
        }
      ]
    },
    "views": {
      "quranForClaudeCode": [
        {
          "type": "webview",
          "id": "quranForClaudeCode.reader",
          "name": "Quran"
        }
      ]
    },
    "commands": [
      {
        "command": "quranForClaudeCode.toggle",
        "title": "Toggle On/Off",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.next",
        "title": "Next Ayah",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.prev",
        "title": "Previous Ayah",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.toggleMode",
        "title": "Switch Mode (Random/Continuous)",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.useRandomMode",
        "title": "Switch to Random Mode",
        "category": "Quran",
        "icon": "$(list-ordered)"
      },
      {
        "command": "quranForClaudeCode.useContinuousMode",
        "title": "Switch to Continuous Mode",
        "category": "Quran",
        "icon": "$(list-unordered)"
      },
      {
        "command": "quranForClaudeCode.showTranslation",
        "title": "Show Translation",
        "category": "Quran",
        "icon": "$(eye-closed)"
      },
      {
        "command": "quranForClaudeCode.hideTranslation",
        "title": "Hide Translation",
        "category": "Quran",
        "icon": "$(eye)"
      },
      {
        "command": "quranForClaudeCode.goTo",
        "title": "Go to Ayah…",
        "category": "Quran",
        "icon": "$(search)"
      },
      {
        "command": "quranForClaudeCode.translateSelection",
        "title": "Translate Selection",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.chooseTranslation",
        "title": "Choose Translation…",
        "category": "Quran",
        "icon": "$(globe)"
      },
      {
        "command": "quranForClaudeCode.resetBookmark",
        "title": "Reset Bookmark to Al-Fatihah",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.installHooks",
        "title": "Install Claude Code Hooks",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.uninstallHooks",
        "title": "Uninstall Claude Code Hooks",
        "category": "Quran"
      },
      {
        "command": "quranForClaudeCode.about",
        "title": "About & Attribution",
        "category": "Quran",
        "icon": "$(info)"
      }
    ],
    "configuration": {
      "title": "Quran for Claude Code",
      "properties": {
        "quranForClaudeCode.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch. When off, the panel is not opened automatically and Claude Code activity is ignored. You can still open the panel by hand."
        },
        "quranForClaudeCode.mode": {
          "type": "string",
          "enum": [
            "continuous",
            "random"
          ],
          "enumDescriptions": [
            "Read in order from your bookmark; Next moves the bookmark.",
            "Show a random ayah; does not move your bookmark."
          ],
          "default": "continuous",
          "description": "Reading mode."
        },
        "quranForClaudeCode.translation": {
          "type": "string",
          "enum": [
            "id.indonesian",
            "en.sahih",
            "none"
          ],
          "enumDescriptions": [
            "Bahasa Indonesia — Kementerian Agama RI",
            "English — Saheeh International",
            "No translation"
          ],
          "default": "en.sahih",
          "markdownDescription": "Translation shown under the Arabic text. You can also switch it from the panel or with **Quran: Choose Translation…**."
        },
        "quranForClaudeCode.showTranslation": {
          "type": "boolean",
          "default": true,
          "description": "Show the translation by default."
        },
        "quranForClaudeCode.arabicFontSize": {
          "type": "number",
          "default": 28,
          "minimum": 12,
          "maximum": 72,
          "description": "Arabic text size in pixels."
        },
        "quranForClaudeCode.navigationDirection": {
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ],
          "enumDescriptions": [
            "\"Next →\" on the right; → key = next.",
            "\"← Next\" on the left; ← key = next (follows Arabic reading direction)."
          ],
          "default": "ltr",
          "description": "Which side the Next button is on, and which arrow key goes to the next ayah."
        },
        "quranForClaudeCode.autoReveal": {
          "type": "boolean",
          "default": true,
          "description": "Show the Quran panel when Claude Code starts working. Never takes keyboard focus."
        },
        "quranForClaudeCode.advanceOnNewTurn": {
          "type": "boolean",
          "default": true,
          "description": "Move to the next ayah (or a new random one) each time you send Claude Code a prompt."
        },
        "quranForClaudeCode.staleBusyMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Treat Claude Code as idle if it has reported 'busy' for longer than this many minutes (protects against a missed Stop event)."
        }
      }
    },
    "colors": [
      {
        "id": "quranForClaudeCode.statusBarBusyForeground",
        "description": "Colour of the Quran status bar item while Claude Code is working.",
        "defaults": {
          "dark": "#E3B341",
          "light": "#9A6700",
          "highContrast": "#FFD700",
          "highContrastLight": "#7A5200"
        }
      }
    ],
    "menus": {
      "webview/context": [
        {
          "command": "quranForClaudeCode.translateSelection",
          "when": "webviewId == 'quranForClaudeCode.reader' && webviewSection == 'arabic'",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "quranForClaudeCode.translateSelection",
          "when": "view.quranForClaudeCode.reader.visible"
        },
        {
          "command": "quranForClaudeCode.useRandomMode",
          "when": "false"
        },
        {
          "command": "quranForClaudeCode.useContinuousMode",
          "when": "false"
        },
        {
          "command": "quranForClaudeCode.showTranslation",
          "when": "false"
        },
        {
          "command": "quranForClaudeCode.hideTranslation",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "quranForClaudeCode.goTo",
          "when": "view == quranForClaudeCode.reader",
          "group": "navigation@1"
        },
        {
          "command": "quranForClaudeCode.useRandomMode",
          "when": "view == quranForClaudeCode.reader && quranForClaudeCode.mode != random",
          "group": "navigation@2"
        },
        {
          "command": "quranForClaudeCode.useContinuousMode",
          "when": "view == quranForClaudeCode.reader && quranForClaudeCode.mode == random",
          "group": "navigation@2"
        },
        {
          "command": "quranForClaudeCode.chooseTranslation",
          "when": "view == quranForClaudeCode.reader",
          "group": "navigation@3"
        },
        {
          "command": "quranForClaudeCode.hideTranslation",
          "when": "view == quranForClaudeCode.reader && quranForClaudeCode.translationAvailable && quranForClaudeCode.showTranslation",
          "group": "navigation@4"
        },
        {
          "command": "quranForClaudeCode.showTranslation",
          "when": "view == quranForClaudeCode.reader && quranForClaudeCode.translationAvailable && !quranForClaudeCode.showTranslation",
          "group": "navigation@4"
        },
        {
          "command": "quranForClaudeCode.resetBookmark",
          "when": "view == quranForClaudeCode.reader",
          "group": "1_reader@1"
        },
        {
          "command": "quranForClaudeCode.installHooks",
          "when": "view == quranForClaudeCode.reader",
          "group": "2_hooks@1"
        },
        {
          "command": "quranForClaudeCode.uninstallHooks",
          "when": "view == quranForClaudeCode.reader",
          "group": "2_hooks@2"
        },
        {
          "command": "quranForClaudeCode.about",
          "when": "view == quranForClaudeCode.reader",
          "group": "3_about@1"
        }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/esbuild.mjs",
    "watch": "node scripts/esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && node scripts/esbuild.mjs --production",
    "lint": "eslint .",
    "build:data": "node scripts/build-data.mjs",
    "test": "mocha",
    "build:icon": "node scripts/build-icon.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "ovsx": "1.4.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2"
  }
}
