{
  "name": "quran-for-claude-code",
  "displayName": "Quran for Claude Code (Unofficial)",
  "description": "Unofficial community extension. Not affiliated with or endorsed by Anthropic. Read the Quran while Claude Code works — totally offline.",
  "version": "0.0.1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Quran for Claude Code",
      "properties": {
        "quranForClaudeCode.mode": {
          "type": "string",
          "enum": [
            "continuous",
            "random"
          ],
          "enumDescriptions": [
            "Read in order from your bookmark; Next moves the bookmark.",
            "Show a random ayah; does not move your bookmark."
          ],
          "default": "continuous",
          "description": "Reading mode."
        },
        "quranForClaudeCode.translation": {
          "type": "string",
          "enum": [
            "id.indonesian",
            "en.sahih",
            "none"
          ],
          "enumDescriptions": [
            "Bahasa Indonesia — Kementerian Agama RI",
            "English — Saheeh International",
            "No translation"
          ],
          "default": "en.sahih",
          "markdownDescription": "Translation shown under the Arabic text. If you never change this, Indonesian is used when VS Code's display language is Indonesian."
        },
        "quranForClaudeCode.showTranslation": {
          "type": "boolean",
          "default": true,
          "description": "Show the translation by default."
        },
        "quranForClaudeCode.arabicFontSize": {
          "type": "number",
          "default": 28,
          "minimum": 12,
          "maximum": 72,
          "description": "Arabic text size in pixels."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/esbuild.mjs",
    "watch": "node scripts/esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run typecheck && node scripts/esbuild.mjs --production",
    "lint": "eslint .",
    "build:data": "node scripts/build-data.mjs",
    "test": "mocha"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.2"
  }
}
